#
# Writes HEADER_FILE from the DXIL container DXIL_FILE: the container's bytes as
# the C array SYMBOL, with its length, in namespace
# Gr2Port::D3D12::Shaders.
#
# Invoked with `cmake -P` from the custom command that gr2port_add_hlsl_shader()
# creates, exactly like the Vulkan backend's shader_header.cmake. The DXIL
# container (not the raw program) is embedded, because
# D3D12CreateRootSignatureDeserializer / CreatePipelineState take the container.

if (NOT EXISTS "${DXIL_FILE}")
    message(FATAL_ERROR "GR2D3D12ShaderHeader: '${DXIL_FILE}' does not exist")
endif()

file(READ "${DXIL_FILE}" MODULE HEX)
string(LENGTH "${MODULE}" MODULE_LEN)
math(EXPR BYTE_COUNT "${MODULE_LEN} / 2")

# "0a1b2c..." -> "0x0a,0x1b,0x2c,"
string(REGEX REPLACE "(..)" "0x\\1," WORDS "${MODULE}")
# Wrap at 16 bytes per line so the generated headers stay reviewable.
string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)"
       "    \\1\n" WORDS "${WORDS}")

file(WRITE "${HEADER_FILE}"
"// Generated by cmake/GR2D3D12ShaderHeader.cmake from ${DXIL_FILE}. Do not edit.
// SPDX-FileCopyrightText: Copyright 2026 GR2toXBOX contributors
// SPDX-License-Identifier: GPL-2.0-or-later
#pragma once
#include <cstdint>
#include <span>

namespace Gr2Port::D3D12::Shaders {

/// ${SYMBOL}: ${STAGE}_6_4 DXIL container, ${BYTE_COUNT} bytes.
inline constexpr std::uint8_t ${SYMBOL}[] = {
${WORDS}
};
inline constexpr std::span<const std::uint8_t> ${SYMBOL}_span = ${SYMBOL};

} // namespace Gr2Port::D3D12::Shaders
")

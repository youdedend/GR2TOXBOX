;
; C++/WinRT provides WINRT_GetActivationFactory. Export the app-model name as
; a private alias so GR2port.App activation resolves through the WinRT runtime.
EXPORTS
    DllGetActivationFactory = WINRT_GetActivationFactory PRIVATE
